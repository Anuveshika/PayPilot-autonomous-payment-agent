PORT=4021
HOST=127.0.0.1
DATA_FILE=.data/database.json
PAYMENT_MODE=demo
DEFAULT_NETWORK=eip155:84532
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
OFFER_SIGNING_SECRET=replace-with-at-least-32-random-characters
DEMO_RAIL_SECRET=replace-with-a-different-random-secret
EMERGENCY_STOP=false

# AI provider: demo | vertex | cloud-run
AI_PROVIDER=demo
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
